datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                           String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  displayName                  String       @map("display_name")
  email                        String       @unique
  status                       UserStatus   @default(ACTIVE)
  marketInterests              String[]     @default([]) @map("market_interests")
  inAppAlertsEnabled           Boolean      @default(true) @map("in_app_alerts_enabled")
  emailVolatilityAlertsEnabled Boolean      @default(true) @map("email_volatility_alerts_enabled")
  dailyDigestEnabled           Boolean      @default(true) @map("daily_digest_enabled")
  phoneNumber                  String?      @unique @map("phone_number")
  phoneVerifiedAt              DateTime?    @map("phone_verified_at") @db.Timestamptz(6)
  plan                         PlanTier     @default(FREE)
  // Internal staff access level (admin ops panel). USER = regular customer.
  platformRole                 PlatformRole @default(USER) @map("platform_role")
  // Prepaid overage credit pool for individual PRO users (integer paisa).
  creditBalanceInPaisa         Int          @default(0) @map("credit_balance_in_paisa")
  // Personal UI preferences (theme, chart layout, indicators), overlaid on the
  // team's `defaultPreferences` when the user belongs to a workspace.
  preferences                  Json?
  deletedAt                    DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletionScheduledAt          DateTime?    @map("deletion_scheduled_at") @db.Timestamptz(6)
  createdAt                    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  userSessions      UserSession[]
  adminAuditLogs    AdminAuditLog[] @relation("AdminActions")
  adminStepUps      AdminStepUp[]
  phoneOtps         PhoneOtp[]
  portfolios        Portfolio[]
  assignedUserRoles UserRole[]      @relation("AssignedRoles")
  userRoles         UserRole[]      @relation("UserRoles")

  // ── Watchlist feature ──────────────────────────────────────────────────────
  watchlistItems    Watchlist[]
  watchlistAlerts   WatchlistAlert[]
  notifications     Notification[]
  newsReadStates    NewsReadState[]
  newsSavedArticles NewsSavedArticle[]
  decisionRuns      DecisionRun[]
  feedbackEntries   Feedback[]

  // ── Payments feature ────────────────────────────────────────────────────────
  // PaymentTransaction / CreditLedger deliberately carry no FK to User: they
  // are immutable audit records that must outlive the user row.
  subscription Subscription?

  // ── Teams feature ───────────────────────────────────────────────────────────
  ownedTeams   Team[]
  teamMembers  TeamMember[]
  joinRequests TeamJoinRequest[]

  @@index([status], map: "idx_users_status")
  @@index([createdAt], map: "idx_users_created_at")
  @@index([updatedAt], map: "idx_users_updated_at")
  @@index([email], map: "idx_users_email")
  @@map("users")
}

model UserSession {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  jti              String    @unique
  previousJti      String?   @map("previous_jti")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  isRevoked        Boolean   @default(false) @map("is_revoked")
  // Last time the staff member re-verified (emailed code) for sensitive admin writes; null = never.
  stepUpVerifiedAt DateTime? @map("step_up_verified_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepUps AdminStepUp[]

  @@index([jti], map: "idx_usersessions_jti")
  @@index([userId], map: "idx_usersessions_userid")
  @@index([expiresAt], map: "idx_usersessions_expires_at")
  @@index([isRevoked], map: "idx_usersessions_is_revoked")
  @@map("user_sessions")
}

// ─── Phone Verification Feature (WhatsApp OTP via SendPK) ────────────────────

model PhoneOtp {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  phoneNumber String    @map("phone_number")
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_phone_otp_user_id")
  @@index([expiresAt], map: "idx_phone_otp_expires_at")
  @@index([userId, consumedAt], map: "idx_phone_otp_user_id_consumed_at")
  @@map("phone_otps")
}

model Portfolio {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions    Position[]
  decisionRuns DecisionRun[]

  @@index([userId], map: "idx_portfolios_user_id")
  @@map("portfolios")
}

model Position {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  portfolioId   String   @map("portfolio_id") @db.Uuid
  symbol        String
  quantity      Float
  avgEntryPrice Float    @map("avg_entry_price")
  sector        String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId], map: "idx_positions_portfolio_id")
  @@index([symbol], map: "idx_positions_symbol")
  @@map("positions")
}

model Role {
  id                      String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name                    String             @unique
  description             String?
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  rolePermissions         RolePermission[]
  userRoles               UserRole[]
  defaultForConfiguration RbacConfiguration? @relation("DefaultUserRole")

  @@index([name], map: "idx_roles_name")
  @@map("roles")
}

model RbacConfiguration {
  id            String   @id @default("system")
  defaultRoleId String?  @unique @map("default_role_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  defaultRole Role? @relation("DefaultUserRole", fields: [defaultRoleId], references: [id], onDelete: SetNull)

  @@map("rbac_configuration")
}

model UserRole {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String   @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedBy   User     @relation("AssignedRoles", fields: [assignedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user         User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId], map: "idx_userroles_userid")
  @@index([roleId], map: "idx_userroles_roleid")
  @@index([assignedById], map: "idx_userroles_assignedbyid")
  @@index([createdAt], map: "idx_userroles_created_at")
  @@map("user_roles")
}

model Resource {
  id          String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions Permission[]

  @@index([name], map: "idx_resources_name")
  @@map("resources")
}

model Permission {
  id              String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  action          String
  resourceId      String           @map("resource_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  resource        Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([action, resourceId])
  @@index([action], map: "idx_permissions_action")
  @@index([resourceId], map: "idx_permissions_resourceid")
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId], map: "idx_rolepermissions_roleid")
  @@index([permissionId], map: "idx_rolepermissions_permissionid")
  @@map("role_permissions")
}

// ─── Magic Link Feature ──────────────────────────────────────────────────────

model MagicLinkToken {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email     String
  tokenHash String   @unique @map("token_hash")
  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tokenHash], map: "idx_magic_link_token_hash")
  @@index([email], map: "idx_magic_link_email")
  @@map("magic_link_tokens")
}

// ─── Watchlist Feature ────────────────────────────────────────────────────────

model Watchlist {
  id     String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  symbol String

  // User-defined trade plan — never overwritten by AI fields
  targetEntryPrice Float?  @map("target_entry_price")
  stopLoss         Float?  @map("stop_loss")
  notes            String? @db.VarChar(500)

  // Captured by async job (M2) — used to compute priceSinceAdded on GET
  priceAtCreatedAt Float? @map("price_at_created_at")

  // AI-computed suggestions — never overwrite user-defined fields (M7)
  aiSuggestedEntry  Float?        @map("ai_suggested_entry")
  aiTakeProfit      Float?        @map("ai_take_profit")
  aiStopLoss        Float?        @map("ai_stop_loss")
  aiConfidence      AiConfidence?
  aiSuggestionBasis String?       @map("ai_suggestion_basis")
  aiComputedAt      DateTime?     @map("ai_computed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts WatchlistAlert[]

  @@unique([userId, symbol], map: "uniq_watchlist_user_symbol")
  @@index([userId], map: "idx_watchlist_user_id")
  @@map("watchlists")
}

model WatchlistAlert {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  watchlistId   String    @map("watchlist_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  type          AlertType
  threshold     Float?
  isActive      Boolean   @default(true) @map("is_active")
  lastSeenValue String?   @map("last_seen_value")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  watchlist Watchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      AlertLog[]

  @@index([watchlistId], map: "idx_watchlist_alerts_watchlist_id")
  @@index([userId], map: "idx_watchlist_alerts_user_id")
  @@index([isActive], map: "idx_watchlist_alerts_is_active")
  @@map("watchlist_alerts")
}

model AlertLog {
  id      String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  alertId String   @map("alert_id") @db.Uuid
  firedAt DateTime @default(now()) @map("fired_at") @db.Timestamptz(6)

  alert WatchlistAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId], map: "idx_alert_logs_alert_id")
  @@index([firedAt], map: "idx_alert_logs_fired_at")
  @@map("alert_logs")
}

model Notification {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_notifications_user_id")
  @@index([read], map: "idx_notifications_read")
  @@index([createdAt], map: "idx_notifications_created_at")
  @@map("notifications")
}

model Feedback {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  message   String
  page      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_feedback_user_id")
  @@index([createdAt], map: "idx_feedback_created_at")
  @@map("feedback")
}

model NewsArticle {
  id             String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  url            String         @unique // deduplication key
  headline       String
  summaryBullets String[] // max 3 bullets, parsed at ingest @map("summary_bullets")
  source         String // e.g. "Reuters", "Bloomberg"
  imageUrl       String?        @map("image_url")
  publishedAt    DateTime       @map("published_at") @db.Timestamptz(6)
  category       NewsCategory
  sentiment      NewsSentiment?
  sentimentScore Float?         @map("sentiment_score") // -1.0 to 1.0, from Polygon.io only
  relatedSymbols String[]       @map("related_symbols") // e.g. ["NVDA", "AMD"]
  sector         String? // populated for sector-level articles
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  readStates   NewsReadState[]
  savedByUsers NewsSavedArticle[]

  @@index([publishedAt(sort: Desc)], map: "idx_news_published_at")
  @@index([relatedSymbols], map: "idx_news_related_symbols")
  @@index([category], map: "idx_news_category")
  @@index([sentiment], map: "idx_news_sentiment")
  @@index([createdAt], map: "idx_news_created_at")
  @@map("news_articles")
}

model NewsReadState {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId], map: "uniq_news_read_user_article")
  @@index([userId], map: "idx_news_read_user_id")
  @@index([articleId], map: "idx_news_read_article_id")
  @@map("news_read_states")
}

model NewsSavedArticle {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  savedAt   DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId], map: "uniq_news_saved_user_article")
  @@index([userId], map: "idx_news_saved_user_id")
  @@index([articleId], map: "idx_news_saved_article_id")
  @@index([savedAt], map: "idx_news_saved_saved_at")
  @@map("news_saved_articles")
}

model DecisionRun {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  portfolioId String   @map("portfolio_id") @db.Uuid
  mode        String   @default("DETAILED")
  runAt       DateTime @default(now()) @map("run_at") @db.Timestamptz(6)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio Portfolio        @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  results   DecisionResult[]

  @@index([userId], map: "idx_decision_runs_user_id")
  @@index([portfolioId], map: "idx_decision_runs_portfolio_id")
  @@index([runAt(sort: Desc)], map: "idx_decision_runs_run_at")
  @@map("decision_runs")
}

model DecisionResult {
  id                String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  runId             String  @map("run_id") @db.Uuid
  symbol            String
  sector            String?
  marketDecision    String  @map("market_decision")
  portfolioDecision String  @map("portfolio_decision")
  confidence        Float
  riskLevel         String  @map("risk_level")
  reasoning         Json
  exposure          Json
  actionGuidance    Json    @map("action_guidance")

  run DecisionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId], map: "idx_decision_results_run_id")
  @@index([symbol], map: "idx_decision_results_symbol")
  @@map("decision_results")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum NewsCategory {
  EARNINGS
  ANALYST
  FILING
  MERGER
  MACRO
  SECTOR
  GENERAL
}

enum NewsSentiment {
  BULLISH
  BEARISH
  NEUTRAL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  PCT_CHANGE_UP
  PCT_CHANGE_DOWN
  ENTRY_ZONE
  STOP_LOSS_BREACHED
  EARNINGS_APPROACHING
  DIVIDEND_APPROACHING
  ANALYST_RATING_CHANGE
  NEWS_PUBLISHED
  SEC_FILING
  AI_SIGNAL_CHANGED
}

enum AiConfidence {
  LOW
  MEDIUM
  HIGH
}

enum PlanTier {
  FREE
  PRO
  TEAM
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

// What a PaymentTransaction buys. TOPUP is deliberately not a PlanTier value:
// User.plan must never be able to hold it.
enum PaymentKind {
  SUBSCRIPTION
  SEAT_ADDITION
  TOPUP
}

enum TeamStatus {
  ACTIVE
  CANCELLED
}

// How people on a verified company domain can get into the workspace.
enum TeamJoinPolicy {
  INVITE_ONLY
  REQUEST_APPROVAL
  AUTO_APPROVE
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamAuditAction {
  MEMBER_INVITED
  INVITE_REVOKED
  INVITE_RESENT
  INVITE_ACCEPTED
  JOIN_REQUESTED
  JOIN_APPROVED
  JOIN_DECLINED
  JOIN_POLICY_SET
  MEMBER_REMOVED
  MEMBER_LEFT
  ROLE_CHANGED
  OWNERSHIP_TRANSFERRED
  SETTINGS_UPDATED
  DOMAIN_ADDED
  DOMAIN_VERIFIED
  SEATS_ADDED
  SEAT_REDUCTION_SCHEDULED
  SEAT_REDUCTION_CANCELLED
  CREDIT_LIMIT_SET
  BILLING_CONTACT_UPDATED
  TEAM_RENAMED
  TEAM_DELETED
  TEAM_EXPORTED
  SUBSCRIPTION_EXPIRED
}

enum CreditLedgerType {
  PURCHASE
  OVERAGE_CONSUMPTION
  REFUND
  MANUAL_ADJUSTMENT
}

enum PlatformRole {
  USER
  SUPPORT_AGENT
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum AdminAuditAction {
  PLAN_OVERRIDE
  CREDIT_INJECTION
  SUBSCRIPTION_EXTENDED
  DOMAIN_FORCE_VERIFIED
  SEAT_CAPACITY_OVERRIDE
  MEMBER_FORCE_REMOVED
  USER_SESSION_INVALIDATED
  FEATURE_FLAG_TOGGLED
  EMERGENCY_MARKET_TOGGLED
  PLATFORM_ROLE_GRANTED
  WEBHOOK_RETRIED
  CUSTOMER_DATA_VIEWED
  CUSTOMER_DATA_REVEALED
}

enum SubscriptionPaymentMethod {
  CARD
  WALLET
}

enum SubscriptionStatus {
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}

// ─── Safepay Payments (Pro / Team checkout, seat additions, credit top-ups) ───
// Immutable audit record: no FK to User/Team so history survives deletion.

model PaymentTransaction {
  id                String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  teamId            String?       @map("team_id") @db.Uuid
  trackerId         String        @unique @map("tracker_id")
  token             String?
  // Safepay pay-in amounts are integer paisa, e.g. Rs 5,999 -> 599900.
  // Column keeps its original name (`amount`) so `db push` never drops data.
  amountPaisa       Int           @map("amount")
  seatCount         Int           @default(1) @map("seat_count")
  currency          String        @default("PKR")
  status            PaymentStatus @default(PENDING)
  kind              PaymentKind   @default(SUBSCRIPTION)
  paymentMethod     String?       @map("payment_method")
  planTier          PlanTier      @map("plan_tier")
  metadata          Json?
  rawWebhookPayload Json?         @map("raw_webhook_payload")
  subscriptionId    String?       @map("subscription_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_payment_transactions_user_id")
  @@index([teamId], map: "idx_payment_transactions_team_id")
  @@index([status], map: "idx_payment_transactions_status")
  @@index([trackerId], map: "idx_payment_transactions_tracker_id")
  @@index([subscriptionId], map: "idx_payment_transactions_subscription_id")
  @@map("payment_transactions")
}

// Append-only credit audit trail. Signed amounts: PURCHASE/REFUND positive,
// OVERAGE_CONSUMPTION negative. No FKs, so history survives user/team deletion.
model CreditLedger {
  id          String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String?          @map("user_id") @db.Uuid
  teamId      String?          @map("team_id") @db.Uuid
  amountPaisa Int              @map("amount_paisa")
  type        CreditLedgerType
  description String
  trackerId   String?          @map("tracker_id")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "idx_credit_ledger_user_id")
  @@index([teamId], map: "idx_credit_ledger_team_id")
  @@index([createdAt], map: "idx_credit_ledger_created_at")
  @@map("credit_ledger")
}

// ─── Subscription (PRO / TEAM billing cycle) ─────────────────────────────────
// One row per user (PRO) or per team (TEAM) — exactly one of userId/teamId is
// set — tracking the current billing period regardless of payment method.
// CARD subscriptions auto-renew (see payments/subscription-job.ts), WALLET
// subscriptions are a manual 30-day access pass. Team subscriptions are always
// manual-renewal: Safepay's recurring Plan product is fixed-price and cannot
// express a per-seat amount. `PaymentTransaction` rows link back here via
// `subscriptionId` so the transaction history stays an append-only ledger
// while this row holds the current renewal/grace/expiry state.
model Subscription {
  id                    String                    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId                String?                   @unique @map("user_id") @db.Uuid
  teamId                String?                   @unique @map("team_id") @db.Uuid
  planTier              PlanTier                  @map("plan_tier")
  paymentMethod         SubscriptionPaymentMethod @map("payment_method")
  // Schema default is only the safe fallback — application code always sets
  // this explicitly per payment method on creation: true for CARD, false for
  // WALLET (wallets have no recurring capability, never toggleable).
  autoRenew             Boolean                   @default(false) @map("auto_renew")
  status                SubscriptionStatus        @default(ACTIVE)
  // Nullable: createCheckoutSession creates this row before the webhook
  // confirms payment; currentPeriodEnd is only set once the webhook lands.
  currentPeriodStart    DateTime                  @default(now()) @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd      DateTime?                 @map("current_period_end") @db.Timestamptz(6)
  gracePeriodEnd        DateTime?                 @map("grace_period_end") @db.Timestamptz(6)
  // Dedup guard for the day-27 reminder email — must be compared against
  // currentPeriodStart (not just null-checked) so the reminder reliably
  // re-fires every renewal cycle, not just on the very first one.
  reminderSentAt        DateTime?                 @map("reminder_sent_at") @db.Timestamptz(6)
  // Safepay's own subscription identifier for the Plan-based recurring-card
  // flow (correlates a `payment.succeeded`/`payment.failed` webhook back to
  // this row) — set once at subscription-checkout creation time (initially
  // to our own `id` as the `reference` we send Safepay, then overwritten if
  // their webhook echoes back a distinct id of their own). Never set for
  // WALLET or TEAM subscriptions.
  safepaySubscriptionId String?                   @unique @map("safepay_subscription_id")
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([status], map: "idx_subscriptions_status")
  @@index([currentPeriodEnd], map: "idx_subscriptions_current_period_end")
  @@map("subscriptions")
}

// ─── Teams (B2B workspaces) ──────────────────────────────────────────────────

model Team {
  id                    String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name                  String
  ownerId               String     @map("owner_id") @db.Uuid
  // Enforced 2..150 in the service layer (Prisma has no CHECK constraints).
  seatCapacity          Int        @map("seat_capacity")
  status                TeamStatus @default(ACTIVE)
  // Workspace-wide AI context appended to forecast/decision responses.
  orgInstructions       String?    @map("org_instructions")
  // Workspace default UI preferences; individual User.preferences overlay them.
  defaultPreferences    Json?      @map("default_preferences")
  creditBalanceInPaisa  Int        @default(0) @map("credit_balance_in_paisa")
  // Receives renewal reminders and receipts; falls back to the owner's email when unset.
  billingEmail          String?    @map("billing_email")
  // Seat count the next renewal bills (a scheduled reduction); null = keep seatCapacity.
  scheduledSeatCapacity Int?       @map("scheduled_seat_capacity")
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  owner            User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  domains          TeamDomain[]
  members          TeamMember[]
  invites          TeamInvite[]
  joinRequests     TeamJoinRequest[]
  subscription     Subscription?
  sharedWatchlists SharedWatchlist[]
  sharedScreeners  SharedScreener[]
  researchNotes    SharedResearchNote[]

  // Not unique: a deleted (CANCELLED) workspace keeps its owner for history, who may then start a new one.
  @@index([ownerId])
  @@map("teams")
}

model TeamDomain {
  id                  String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  teamId              String         @map("team_id") @db.Uuid
  domain              String         @unique
  // DNS TXT proof-of-ownership token (see teams/domain-verification.ts).
  verificationToken   String         @map("verification_token")
  isVerified          Boolean        @default(false) @map("is_verified")
  restrictOrgCreation Boolean        @default(true) @map("restrict_org_creation")
  joinPolicy          TeamJoinPolicy @default(INVITE_ONLY) @map("join_policy")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId], map: "idx_team_domains_team_id")
  @@map("team_domains")
}

model TeamMember {
  id                      String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  teamId                  String   @map("team_id") @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  role                    TeamRole
  // Optional per-user cap on monthly draw from the team's shared credit pool.
  monthlyCreditLimitPaisa Int?     @map("monthly_credit_limit_paisa")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId], map: "uq_team_members_team_user")
  // A user belongs to at most one workspace, which keeps plan resolution unambiguous.
  @@unique([userId], map: "uq_team_members_user")
  @@map("team_members")
}

model TeamInvite {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  email     String
  role      TeamRole @default(MEMBER)
  // SHA-256 hash of the emailed token; the raw token is never stored.
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId], map: "idx_team_invites_team_id")
  @@index([email], map: "idx_team_invites_email")
  @@map("team_invites")
}

// A user on a verified company domain asking to join the workspace. One row per
// (team, user); a re-request reopens it, so history is the audit log, not rows.
model TeamJoinRequest {
  id        String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  teamId    String            @map("team_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  status    JoinRequestStatus @default(PENDING)
  decidedBy String?           @map("decided_by") @db.Uuid
  decidedAt DateTime?         @map("decided_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId], map: "uq_team_join_requests_team_user")
  @@index([teamId, status], map: "idx_team_join_requests_team_status")
  @@index([userId], map: "idx_team_join_requests_user_id")
  @@map("team_join_requests")
}

model SharedWatchlist {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  name      String
  symbols   String[] @default([])
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId], map: "idx_shared_watchlists_team_id")
  @@map("shared_watchlists")
}

model SharedScreener {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  name      String
  criteria  Json
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId], map: "idx_shared_screeners_team_id")
  @@map("shared_screeners")
}

model SharedResearchNote {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  symbol    String
  content   String
  authorId  String   @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId], map: "idx_shared_research_notes_team_id")
  @@index([symbol], map: "idx_shared_research_notes_symbol")
  @@map("shared_research_notes")
}

// ─── Team admin audit trail ─────────────────────────────────────────────────
// Append-only record of administrative actions. No FKs and no personal data
// (IDs and enum values only) so it survives member / workspace deletion.
model TeamAuditLog {
  id           String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  teamId       String          @map("team_id") @db.Uuid
  actorUserId  String?         @map("actor_user_id") @db.Uuid
  action       TeamAuditAction
  targetUserId String?         @map("target_user_id") @db.Uuid
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([teamId, createdAt], map: "idx_team_audit_team_created")
  @@map("team_audit_logs")
}

// ─── Metered usage (base-quota counting + team analytics) ────────────────────
// One row per metered AI action. Also the source of truth for the monthly base
// quota, so it needs no Redis and survives restarts. No FKs: analytics history
// is retained after membership changes.
model UsageEvent {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  teamId    String?  @map("team_id") @db.Uuid
  feature   String
  symbol    String?
  // Paisa drawn from a credit pool for this event; 0 when covered by base quota.
  costPaisa Int      @default(0) @map("cost_paisa")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt], map: "idx_usage_events_user_created")
  @@index([teamId, createdAt], map: "idx_usage_events_team_created")
  @@map("usage_events")
}

// ─── Internal staff admin audit trail ────────────────────────────────────────
// Immutable record of every write performed through /api/v1/admin. Restrict
// keeps a staff user from being deleted while audit rows still reference them.
model AdminAuditLog {
  id         String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  adminId    String           @map("admin_id") @db.Uuid
  action     AdminAuditAction
  targetType String           @map("target_type") // USER | TEAM | SUBSCRIPTION | PAYMENT | SYSTEM
  targetId   String           @map("target_id")
  reason     String
  // Support-ticket reference (e.g. SUP-1234) tying the action to its request.
  ticketRef  String?          @map("ticket_ref")
  metadata   Json?
  ipAddress  String?          @map("ip_address")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  admin User @relation("AdminActions", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId], map: "idx_admin_audit_admin_id")
  @@index([targetId], map: "idx_admin_audit_target_id")
  @@index([action], map: "idx_admin_audit_action")
  @@index([ticketRef], map: "idx_admin_audit_ticket_ref")
  @@index([createdAt], map: "idx_admin_audit_created_at")
  @@map("admin_audit_logs")
}

// ─── Staff step-up verification ──────────────────────────────────────────────
// One-time emailed codes that let a staff session perform sensitive admin
// writes for a short window. Only the hash of the code is stored.
model AdminStepUp {
  id         String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, consumedAt], map: "idx_admin_step_up_session_consumed")
  @@index([userId], map: "idx_admin_step_up_user_id")
  @@map("admin_step_ups")
}
