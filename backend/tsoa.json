{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/modules/**/*Controller.ts"],
  "spec": {
    "outputDirectory": "src/generated",
    "specVersion": 3,
    "info": {
      "title": "StockPros API",
      "version": "1.0.0",
      "description": "Stock prediction, decision making, portfolio analytics and market intelligence API."
    },
    "securityDefinitions": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "routes": {
    "routesDir": "src/generated",
    "authenticationModule": "src/shared/infrastructure/authentication.ts"
  }
}
