{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "stock-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-shared-assets.cjs",
    "start": "node dist/index.js",
    "dev": "nodemon -r tsconfig-paths/register src/index.ts",
    "test": "jest",
    "test:finnhub": "jest src/modules/market/infrastructure/finnhub-stream.test.ts",
    "architecture:check": "node scripts/check-module-boundaries.cjs",
    "db:sync": "npx ts-node scripts/convert-schema-to-snakecase.ts && npx prettier --write prisma/schema.prisma && prisma db push && npx prisma generate"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "keywords": [],
  "author": "Hamza Ahmed",
  "private": true,
  "description": "Stock prediction, decision making and analytics platform.",
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "axios": "^1.13.1",
    "bullmq": "^5.71.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lodash": "^4.17.21",
    "module-alias": "^2.3.4",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "prettier": "^3.7.4",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^6.17.1",
    "resend": "^6.11.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "technicalindicators": "^3.1.0",
    "ts-node": "^10.9.2",
    "uuidv7": "^1.0.2",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5",
    "yahoo-finance2": "^3.13.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.3",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.5",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
