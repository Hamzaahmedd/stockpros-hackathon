# StockPros Backend — secrets only.
# Non-sensitive, environment-specific settings live in src/config/{development,test,production}.ts.
# NODE_ENV selects which config file is loaded.

NODE_ENV=development

# Ops kill-switch (not a secret — an env var so it can be flipped without a code change).
# true/1 = treat the US market as closed regardless of the NYSE calendar (unscheduled halts).
# Only the INITIAL state: it can be toggled at runtime afterwards (setEmergencyClosed(), per process). Unset or false = normal calendar. Any other value fails startup.
EMERGENCY_MARKET_CLOSED=false

# Data stores
DATABASE_URL=postgresql://user:password@host:port/database_name?sslmode=require
REDIS_URL=redis://:password@host:port/db

# Auth secrets
ACCESS_TOKEN_SECRET=your_secure_secret_key
REFRESH_TOKEN_SECRET=your_secure_secret_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
CORS_ORIGINS=your_cors_origins
# Public base URL of this API, required when SSO is enabled in production (SAML ACS URLs are built from it)
API_PUBLIC_URL=https://api.example.com

# SMTP credentials
SMTP_USER=your_email@example.com
SMTP_PASS=email_password

# Third-party API keys
FINNHUB_API_KEY=your_finnhub_api_key
FMP_API_KEY=your_fmp_api_key
TWELVE_DATA_API_KEY=your_twelve_data_api_key
POLYGON_API_KEY=your_polygon_api_key
RESEND_API_KEY=your_resend_api_key
GROQ_API_KEY=your_groq_api_key

# SendPK (WhatsApp OTP phone verification)
SENDPK_API_KEY=your_sendpk_api_key
SENDPK_TEMPLATE_ID=your_sendpk_template_id

# Safepay (Pro tier checkout — JazzCash/Easypaisa/card via hosted checkout)
SAFEPAY_API_KEY=your_safepay_api_key
SAFEPAY_SECRET_KEY=your_safepay_secret_key
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret
# Recurring-billing "Pro Monthly" Plan id, set up once in Safepay's merchant
# dashboard (their Plan-based subscription product has no known create-via-API
# path) — required only for the CARD auto-renew checkout flow.
SAFEPAY_PRO_PLAN_ID=your_safepay_pro_plan_id

# Observability
AXIOM_TOKEN=your_axiom_token
POSTHOG_API_KEY=your_posthog_project_api_key

# Optional: Slack or Discord incoming-webhook URL pinged for each new piece of user
# feedback. https on hooks.slack.com / discord.com only; leave empty to disable.
FEEDBACK_WEBHOOK_URL=

# Optional: Slack or Discord incoming-webhook URL for operational alerts (payments
# needing attention, failed background jobs, risky staff actions). Use a different
# channel from feedback. https on hooks.slack.com / discord.com only.
OPS_ALERT_WEBHOOK_URL=
